# ===========================================
# OPENCLAW - CONFIGURACIÓN
# ===========================================
# Copiar a .env y completar SOLO los valores marcados con =
# ===========================================

# ---- MINIMAX (modelo que usaremos) ----
# Obtener API key en: https://platform.minimaxi.com/
MINIMAX_API_KEY=

# ---- TOKEN DEL GATEWAY (se genera automáticamente) ----
# No modificar - se genera solo en setup
OPENCLAW_GATEWAY_TOKEN=

# ---- TELEGRAM (opcional - descomenta si lo usas) ----
# Obtener token via @BotFather en Telegram
# OPENCLAW_TELEGRAM_BOT_TOKEN=

# ---- CONFIGURACIÓN AVANZADA (no modificar) ----
OPENCLAW_MODEL=minimax/MiniMax-M2.7
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_GATEWAY_MODE=local
OPENCLAW_DISABLE_BONJOUR=1
OPENCLAW_TELEGRAM_DM_POLICY=pairing
OPENCLAW_WHATSAPP_DM_POLICY=pairing

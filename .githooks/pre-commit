#!/bin/bash
# ===========================================
# PRE-COMMIT HOOK
# Valida que no haya datos sensibles antes de commitear
# ===========================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 Validando archivos antes de commit..."

# Rutas a verificar (archivos que contienen secrets reales)
SENSITIVE_FILES=(
    "openclaw.json"
    "config.env"
    "secrets.yaml"
    "credentials.json"
)

# EXCLUSIONES: archivos que son OK aunque contengan .env en el nombre
SENSITIVE_FILES_EXCLUDE=(
    ".env.example"
    "env.example"
    "openclaw.env.example"
    "config.env.example"
)

# Archivos que son templates/documentación y NO deberían tener valores reales
TEMPLATE_FILES=(
    "openclaw.env.example"
    ".env.example"
    "config.env.example"
)

# Patrones sensibles a buscar SOLO si tienen valores reales
# No matchea placeholders como "your-key-here", "tu-key", "xxx", etc.
SENSITIVE_PATTERNS=(
    # Tokens JWT reales
    "eyJ[a-zA-Z0-9]{20,}"
    "bearer[_\s]+[a-zA-Z0-9]{30,}"
    # Tokens reales de GitHub
    "ghp_[a-zA-Z0-9]{36}"
    # AWS access keys reales
    "AKIA[0-9A-Z]{16}"
    # Keys privadas reales
    "-----BEGIN.*PRIVATE KEY-----"
    "-----BEGIN RSA PRIVATE KEY-----"
)

# Valores placeholder que NO son sensibles
PLACEHOLDER_VALUES=(
    "your-api-key"
    "tu-api-key"
    "your-key"
    "tu-key"
    "sk-ant-xxxxx"
    "sk-xxx"
    "xxx"
    "YOUR_TOKEN"
    "TU_TOKEN"
    "<token>"
    "your-token"
    "tu-token"
    "example"
    "placeholder"
    "123456789:ABCdefGHI"
)

ERRORS=0
WARNINGS=0

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Bloqueo directo de dotenv reales (excepto templates)
for file in $STAGED_FILES; do
    if [[ "$file" =~ (^|/)\.env($|\.) ]] && [[ ! "$file" =~ \.env\.example$ ]]; then
        echo -e "${RED}❌ ERROR: Archivo dotenv real en staging: $file${NC}"
        echo "   Usa .env.example para templates y deja .env fuera de git"
        ERRORS=$((ERRORS + 1))
    fi
done

# ===========================================
# HELPER: Es valor real o placeholder?
# ===========================================
is_real_value() {
    local value="$1"
    local lower_value=$(echo "$value" | tr '[:upper:]' '[:lower:]')

    for placeholder in "${PLACEHOLDER_VALUES[@]}"; do
        local lower_placeholder=$(echo "$placeholder" | tr '[:upper:]' '[:lower:]')
        if [[ "$lower_value" == *"$lower_placeholder"* ]]; then
            return 1  # Es placeholder
        fi
    done

    # Si tiene 20+ caracteres alfanuméricos, probablemente es real
    if [[ "$value" =~ ^[a-zA-Z0-9+/]{20,}$ ]] || [[ "$value" =~ ^[a-zA-Z0-9_:-]{30,}$ ]]; then
        return 0  # Es real
    fi

    return 1  # Es placeholder
}

# ===========================================
# CHECK 1: Archivos sensibles no deberían estar
# ===========================================
echo ""
echo "📋 Verificando archivos sensibles..."

for file in $STAGED_FILES; do
    # Skip exclusions
    IS_EXCLUDED=0
    for exclude in "${SENSITIVE_FILES_EXCLUDE[@]}"; do
        if [[ "$file" == *"$exclude"* ]]; then
            IS_EXCLUDED=1
            break
        fi
    done
    if [ $IS_EXCLUDED -eq 1 ]; then
        continue
    fi

    for sensitive in "${SENSITIVE_FILES[@]}"; do
        if [[ "$file" == *"$sensitive"* ]]; then
            # Es un archivo de secrets real
            echo -e "${RED}❌ ERROR: Archivo sensible encontrado: $file${NC}"
            echo "   Los archivos con datos sensibles NO deben commitearse"
            ERRORS=$((ERRORS + 1))
        fi
    done
done

# ===========================================
# CHECK 2: Templates NO deben tener valores reales
# ===========================================
echo ""
echo "📋 Verificando templates..."

for file in $STAGED_FILES; do
    for template in "${TEMPLATE_FILES[@]}"; do
        if [[ "$file" == *"$template"* ]]; then
            echo "   Verificando $file..."

            # Verificar diff staged
            CONTENT=$(git diff --cached "$file" 2>/dev/null | grep "^+" | grep -v "^+++" || true)

            # Buscar patrones tipo KEY=valor
            while IFS= read -r line; do
                if [[ "$line" =~ ^[^#]*=[a-zA-Z0-9] ]]; then
                    KEY=$(echo "$line" | cut -d'=' -f1 | tr -d ' ')
                    VALUE=$(echo "$line" | cut -d'=' -f2 | tr -d ' "' | tr -d "'")

                    if [ -n "$VALUE" ] && [ "$VALUE" != "" ]; then
                        if ! is_real_value "$VALUE"; then
                            # Es placeholder, OK
                            continue
                        else
                            echo -e "${RED}❌ ERROR: $file tiene valor real en $KEY${NC}"
                            echo "   Valor: ${VALUE:0:10}..."
                            ERRORS=$((ERRORS + 1))
                            break
                        fi
                    fi
                fi
            done <<< "$CONTENT"
        fi
    done
done

# ===========================================
# CHECK 3: Buscar patrones sensibles REALES en archivos
# ===========================================
echo ""
echo "🔎 Buscando patrones sensibles..."

# Filtrar archivos a verificar
CHECK_FILES=$(echo "$STAGED_FILES" | grep -E "\.(json|yaml|yml|sh|js|ts|py|go|rb|env)$" | grep -vE "(example|template)" || true)

for file in $CHECK_FILES; do
    CONTENT=$(git diff --cached "$file" 2>/dev/null | grep "^+" | grep -v "^+++" | tr '\n' ' ' | head -c 5000)

    if [ -z "$CONTENT" ]; then
        continue
    fi

    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        if echo "$CONTENT" | grep -E "$pattern" > /dev/null 2>&1; then
            echo -e "${RED}❌ ERROR: Dato sensible REAL encontrado en $file${NC}"
            echo "   Patrón: $pattern"
            ERRORS=$((ERRORS + 1))
            break
        fi
    done
done

# ===========================================
# CHECK 4: .gitignore debe existir y ser correcto
# ===========================================
echo ""
echo "📋 Verificando .gitignore..."

if [ -f ".gitignore" ]; then
    GITIGNORE_CONTENT=$(cat .gitignore)

    HAS_ENV=0
    HAS_DATA=0

    if echo "$GITIGNORE_CONTENT" | grep -E "(\.env|config/\.env)" > /dev/null 2>&1; then
        HAS_ENV=1
        echo -e "${GREEN}✅ .env está en .gitignore${NC}"
    else
        echo -e "${RED}❌ .gitignore no incluye .env${NC}"
        ERRORS=$((ERRORS + 1))
    fi

    if echo "$GITIGNORE_CONTENT" | grep -E "data/" > /dev/null 2>&1; then
        HAS_DATA=1
        echo -e "${GREEN}✅ data/ está en .gitignore${NC}"
    else
        echo -e "${RED}❌ .gitignore no incluye data/${NC}"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "${RED}❌ No hay .gitignore${NC}"
    ERRORS=$((ERRORS + 1))
fi

# ===========================================
# RESULTADO
# ===========================================
echo ""
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}❌ PRE-COMMIT FALLÓ: $ERRORS error(es)${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo "Para saltar este hook (emergencia):"
    echo "   git commit --no-verify -m 'tu mensaje'"
    exit 1
else
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}✅ Validación passed - listo para commit${NC}"
    echo -e "${GREEN}========================================${NC}"
    [ $WARNINGS -gt 0 ] && echo "(y $WARNINGS advertencia(es))"
    exit 0
fi

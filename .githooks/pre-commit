#!/bin/bash
# ===========================================
# PRE-COMMIT HOOK
# Valida que no haya datos sensibles antes de commitear
# ===========================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 Validando archivos antes de commit..."

# Rutas a verificar
SENSITIVE_FILES=(
    ".env"
    "openclaw.json"
    "config.env"
    "secrets.yaml"
    "credentials.json"
)

# Patrones sensibles a buscar
SENSITIVE_PATTERNS=(
    # Tokens y API keys
    "OPENCLAW_GATEWAY_TOKEN=.*[a-zA-Z0-9]"
    "OPENAI_API_KEY=.*[a-zA-Z0-9]"
    "ANTHROPIC_API_KEY=.*[a-zA-Z0-9]"
    "MINIMAX_API_KEY=.*[a-zA-Z0-9]"
    "TELEGRAM_BOT_TOKEN=.*[a-zA-Z0-9]"
    "WHATSAPP.*=.*[a-zA-Z0-9]"
    "api[_-]?key.*=.*['\"][a-zA-Z0-9]{20,}['\"]"
    "api[_-]?secret.*=.*['\"][a-zA-Z0-9]{20,}['\"]"

    # Tokens JWT, tokens de acceso
    "eyJ[a-zA-Z0-9]{10,}"
    "bearer[_\s]+[a-zA-Z0-9]{20,}"

    # Keys privadas
    "-----BEGIN.*PRIVATE KEY-----"
    "-----BEGIN RSA PRIVATE KEY-----"
    "-----BEGIN EC PRIVATE KEY-----"

    # Contraseñas hardcodeadas
    "password\s*=\s*['\"][^'\"]{8,}['\"]"
    "passwd\s*=\s*['\"][^'\"]{8,}['\"]"
    "secret\s*=\s*['\"][^'\"]{8,}['\"]"

    # AWS keys
    "AKIA[0-9A-Z]{16}"
    "aws[_-]?secret[_-]?access[_-]?key.*=.*"

    # Tokens de github
    "ghp_[a-zA-Z0-9]{36}"
    "github[_-]?token.*=.*"
)

# Archivos staging
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

ERRORS=0

# ===========================================
# CHECK 1: Archivos sensibles no deberían estar
# ===========================================
echo ""
echo "📋 Verificando archivos sensibles..."

for file in $STAGED_FILES; do
    for sensitive in "${SENSITIVE_FILES[@]}"; do
        if [[ "$file" == *"$sensitive"* ]]; then
            # Si es un archivo .env, verificar que no tenga valores reales
            if [[ "$file" == *".env"* ]]; then
                CONTENT=$(git diff --cached "$file" | grep "^+" | grep -v "^+++" | head -50)
                if echo "$CONTENT" | grep -E "^[+] *[A-Z_]+= *[a-zA-Z0-9]" > /dev/null 2>&1; then
                    echo -e "${RED}❌ ERROR: $file parece tener valores configurados${NC}"
                    echo "   Los archivos .env con valores reales NO deben commitearse"
                    ERRORS=$((ERRORS + 1))
                fi
            else
                echo -e "${RED}❌ ERROR: Archivo sensible encontrado: $file${NC}"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done
done

# ===========================================
# CHECK 2: Buscar patrones sensibles en archivos
# ===========================================
echo ""
echo "🔎 Buscando patrones sensibles en archivos..."

# Filtrar archivos binary y archivos pequeños
CHECK_FILES=$(echo "$STAGED_FILES" | grep -E "\.(json|yaml|yml|env|txt|md|sh|js|ts|py|go|rb)$" || true)

for file in $CHECK_FILES; do
    # Skip si es un archivo de configuración nuestro que no debería tener valores
    if [[ "$file" == *"openclaw.env.example"* ]] || [[ "$file" == *".env.example"* ]]; then
        continue
    fi

    # Verificar el diff staged
    CONTENT=$(git diff --cached "$file" 2>/dev/null | grep "^+" | grep -v "^+++" | tr -d '\n' | head -c 10000)

    if [ -z "$CONTENT" ]; then
        continue
    fi

    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        if echo "$CONTENT" | grep -E "$pattern" > /dev/null 2>&1; then
            echo -e "${RED}❌ ERROR: Posible dato sensible encontrado en $file${NC}"
            echo "   Patrón: $pattern"
            ERRORS=$((ERRORS + 1))
            break
        fi
    done
done

# ===========================================
# CHECK 3: Verificar que data/ no esté
# ===========================================
echo ""
echo "📁 Verificando directorio data/..."

if echo "$STAGED_FILES" | grep -E "^data/" > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: El directorio data/ NO debe commitearse${NC}"
    echo "   Contiene datos sensibles: sesiones, credenciales, tokens"
    ERRORS=$((ERRORS + 1))
fi

if echo "$STAGED_FILES" | grep -E "\.openclaw/openclaw\.json$" > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: openclaw.json con configuración real no debe commitearse${NC}"
    ERRORS=$((ERRORS + 1))
fi

# ===========================================
# CHECK 4: .gitignore debe incluir .env y data/
# ===========================================
echo ""
echo "📋 Verificando .gitignore..."

if [ -f ".gitignore" ]; then
    GITIGNORE_CONTENT=$(cat .gitignore)

    HAS_ENV=0
    HAS_DATA=0

    if echo "$GITIGNORE_CONTENT" | grep -E "(\.env|config/\.env)" > /dev/null 2>&1; then
        HAS_ENV=1
        echo -e "${GREEN}✅ .env está en .gitignore${NC}"
    fi

    if echo "$GITIGNORE_CONTENT" | grep -E "^data/" > /dev/null 2>&1; then
        HAS_DATA=1
        echo -e "${GREEN}✅ data/ está en .gitignore${NC}"
    fi

    if [ $HAS_ENV -eq 0 ] || [ $HAS_DATA -eq 0 ]; then
        echo -e "${RED}❌ .gitignore no incluye archivos sensibles${NC}"
        [ $HAS_ENV -eq 0 ] && echo "   Falta: .env o config/.env"
        [ $HAS_DATA -eq 0 ] && echo "   Falta: data/"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "${YELLOW}⚠️  ADVERTENCIA: No hay .gitignore${NC}"
fi

# ===========================================
# RESULTADO
# ===========================================
echo ""
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}❌ PRE-COMMIT FALLÓ: $ERRORS error(es)${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo "Solución:"
    echo "1. Elimina los datos sensibles de los archivos"
    echo "2. Mueve datos reales a un archivo .env.local (ya ignorado)"
    echo "3. Usa config/.env.example como template"
    echo ""
    echo "Para saltar este hook (NO recomendado):"
    echo "   git commit --no-verify -m 'tu mensaje'"
    exit 1
else
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}✅ Validación passed - listo para commit${NC}"
    echo -e "${GREEN}========================================${NC}"
    exit 0
fi
